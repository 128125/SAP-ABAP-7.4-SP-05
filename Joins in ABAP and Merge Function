*==================================================================================================================================
* Left Outer Join
*==================================================================================================================================
* Based on the given company codes to display the company codes , comapany names and customer numbers and also display the
* Comapny details , if the company have no customers.(Left outer Join )
*TABLES t001.
*SElect-OPTIONS s_bukrs for t001-bukrs.
*
*TYPES : BEGIN OF ty_final,
*        bukrs TYPE t001-bukrs,
*        butxt TYPE t001-butxt,
*        kunnr TYPE knb1-kunnr,
*        end of ty_final.
*
*DATA : wa_final TYPE ty_final,
*       it_final TYPE table of ty_final.
*
*SELECT t001~bukrs t001~butxt knb1~kunnr into TABLE it_final
*  from t001 left outer join knb1 on t001~bukrs = knb1~bukrs
*  WHERE t001~bukrs in s_bukrs.
*
*Loop at it_final INTO wa_final.
*  WRITE :/ wa_final-bukrs , wa_final-butxt , wa_final-kunnr.
*ENDLOOP.
*==================================================================================================================================



* Based on the given customer numbers to display the customer number , customer names , sales document number , document date,
* item numbers , material numbers , material descriptions and net value by using inner join.
* We have -> KUNNR Name1 VBELN AUDAT POSNR MATNR  MAKTX NETWR
TABLES KNA1.
SELECT-OPTIONS S_KUNNR FOR KNA1-KUNNR.
TYPES : BEGIN OF TY_FINAL,
          KUNNR TYPE KNA1-KUNNR,
          NAME1 TYPE KNA1-NAME1,
          VBELN TYPE VBAK-VBELN,
          AUDAT TYPE VBAK-AUDAT,
          POSNR TYPE VBAP-POSNR,
          MATNR TYPE VBAP-MATNR,
          MAKTX TYPE MAKT-MAKTX,
          NETWR TYPE VBAP-NETWR,
        END OF TY_FINAL.
DATA : WA_FINAL TYPE TY_FINAL,
       IT_FINAL TYPE TABLE OF TY_FINAL.
SELECT KNA1~KUNNR KNA1~NAME1 VBAK~VBELN VBAK~AUDAT VBAP~POSNR VBAP~MATNR MAKT~MAKTX VBAP~NETWR INTO TABLE IT_FINAL
  FROM KNA1 INNER JOIN VBAK ON KNA1~KUNNR = VBAK~KUNNR
            INNER JOIN VBAP ON VBAK~VBELN = VBAP~VBELN
            INNER JOIN MAKT ON VBAP~MATNR = MAKT~MATNR
  WHERE KNA1~KUNNR IN S_KUNNR AND MAKT~SPRAS = SY-LANGU.
LOOP AT IT_FINAL INTO WA_FINAL.
  WRITE :/ WA_FINAL-KUNNR ,
           WA_FINAL-NAME1 ,
           WA_FINAL-VBELN ,
           WA_FINAL-AUDAT ,
           WA_FINAL-POSNR ,
           WA_FINAL-MATNR ,
           WA_FINAL-MAKTX ,
           WA_FINAL-NETWR .
ENDLOOP.
